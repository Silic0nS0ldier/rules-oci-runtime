module(
    name = "rules_oci_runtime",
    version = "0.0.0",
    compatibility_level = 1,
)

# To fully update lockfile: bazel mod deps --lockfile_mode=refresh

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_multitool", version = "1.11.1")
bazel_dep(name = "rules_rust", version = "0.69.0")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.92.0"],
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

# Development only: documentation generation, end to end tests and a hermetic
# C toolchain for the Rust toolchain's linker.
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
bazel_dep(name = "rules_oci", version = "2.3.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.7.1", dev_dependency = True)
bazel_dep(name = "portable_cc_toolchain", version = "2025.12.16", dev_dependency = True)

toolchain = use_extension(
    "@portable_cc_toolchain//:extensions.bzl",
    "toolchain",
    dev_dependency = True,
)
