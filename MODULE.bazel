module(
    name = "rules_oci_runtime",
    version = "0.0.0",
    compatibility_level = 1,
)

# To fully update lockfile: bazel mod deps --lockfile_mode=refresh

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")

runc = use_extension("//lib/private:extensions.bzl", "runc")
use_repo(runc, "runc")

# Toolchains registered by the root module take precedence over this default.
register_toolchains("@runc//:all")

# Development only: documentation generation and end to end tests. The launcher
# is built by the `rules_oci_runtime_source` module, which is tested separately.
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.7.1", dev_dependency = True)
