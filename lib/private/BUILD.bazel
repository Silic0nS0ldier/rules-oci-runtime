load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:private"])

bzl_library(
    name = "runc_binary",
    srcs = ["runc_binary.bzl"],
    visibility = [
        "//docs:__subpackages__",
        "//lib:__subpackages__",
    ],
    deps = [":toolchains"],
)

bzl_library(
    name = "toolchains",
    srcs = ["toolchains.bzl"],
    visibility = [
        "//docs:__subpackages__",
        "//lib:__subpackages__",
    ],
)
