load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//lib/private:runc_binary",
        "//lib/private:toolchains",
    ],
)

toolchain_type(
    name = "launcher_toolchain_type",
    no_match_error = """No OCI launcher toolchain could be resolved.

- The target platform may not be linux_amd64 or linux_arm64.
- The ruleset may not have been sourced from a release archive, which includes prebuilt launchers.
- You may have set `--@rules_oci_runtime//lib:prebuilt_launcher=false` to build the launcher from source instead, without adding a dependency on the `rules_oci_runtime_source` module.
    
See https://github.com/Silic0nS0ldier/rules-oci-runtime#toolchains""",
)

toolchain_type(name = "container_runtime_toolchain_type")

# Set to false to build the launcher from source with `rules_oci_runtime_source`,
# whose toolchain would otherwise lose to the prebuilt one registered here.
bool_flag(
    name = "prebuilt_launcher",
    build_setting_default = True,
)

config_setting(
    name = "prebuilt_launcher_enabled",
    flag_values = {":prebuilt_launcher": "True"},
)
