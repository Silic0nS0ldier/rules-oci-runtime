load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//lib/private:runc_binary",
        "//lib/private:toolchains",
    ],
)

toolchain_type(name = "launcher_toolchain_type")

toolchain_type(name = "container_runtime_toolchain_type")

# Set to false to build the launcher from source with `rules_oci_runtime_source`,
# whose toolchain would otherwise lose to the prebuilt one registered here.
bool_flag(
    name = "prebuilt_launcher",
    build_setting_default = True,
)

config_setting(
    name = "prebuilt_launcher_enabled",
    flag_values = {":prebuilt_launcher": "True"},
)
