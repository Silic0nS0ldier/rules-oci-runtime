load("//pgo:defs.bzl", "llvm_profdata")
load("//pgo:profile.bzl", "pgo_profile")

# Absolute path to the profile the launcher is built against, empty by default
# so an ordinary build neither reads it nor rebuilds when it changes. README.md
# has how one is generated and passed.
pgo_profile(
    name = "profile",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

llvm_profdata(
    name = "llvm_profdata",
)
