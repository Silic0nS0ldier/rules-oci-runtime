load("@rules_go//go:def.bzl", "go_binary", "go_library")

# Vendored from https://git.jakstys.lt/undocker.git at v1.2.3 (f8172015a8c52506e4b3de6618da0bc367ee64bc),
# minus test-only sources. Upstream no longer publishes source archives.

package(default_visibility = ["//visibility:private"])

licenses(["notice"])

exports_files(["LICENSE"])

go_binary(
    name = "undocker",
    srcs = ["main.go"],
    pure = "on",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [":rootfs"],
)

go_library(
    name = "rootfs",
    srcs = glob(["rootfs/*.go"]),
    importpath = "git.jakstys.lt/motiejus/undocker/rootfs",
    target_compatible_with = ["@platforms//os:linux"],
)
