module(name = "rules_oci_runtime_e2e_smoke")

bazel_dep(name = "rules_oci_runtime")
local_path_override(
    module_name = "rules_oci_runtime",
    path = "../..",
)

# Builds the launcher from source, registering the launcher toolchain.
bazel_dep(name = "rules_oci_runtime_source")
local_path_override(
    module_name = "rules_oci_runtime_source",
    path = "../../source",
)

bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Writes the `.tar.zst` layer `oci_image` turns into a zstd blob.
bazel_dep(name = "tar.bzl", version = "0.10.8")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "alpine",
    digest = "sha256:4b7ce07002c69e8f3d704a9c5d6fd3053be500b7f1c69fc0d80990c2ad8dd412",
    image = "docker.io/library/alpine",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    tag = "3.22.2",
)
use_repo(
    oci,
    "alpine",
    "alpine_linux_amd64",
    "alpine_linux_arm64_v8",
)
